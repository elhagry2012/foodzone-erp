# انسخ هذا الملف إلى .env (لا يُرفع إلى git) واملأ القيم. على Streamlit Cloud ضعها في Secrets بنفس الأسماء.
# كل القيم اختيارية؛ الفارغ يُتجاهل.

# مسارات البيانات (الافتراضي: مجلد البرنامج)
ELHAGRY_DB=
ELHAGRY_DATA_DIR=
ELHAGRY_ATTACH_DIR=

# المدير الرئيسي: يُستخدم فقط عند إنشاء قاعدة بيانات جديدة بلا مدير
ELHAGRY_ADMIN_USER=
ELHAGRY_ADMIN_PASSWORD=
# استعادة الدخول: 1 يضبط كلمة مرور المدير الرئيسي من ELHAGRY_ADMIN_PASSWORD عند التشغيل (احذفه بعد الاستخدام)
ELHAGRY_ADMIN_RESET=

# كلمات مرور إدارية (تُشفَّر عند أول تشغيل لو لم تكن مضبوطة في البرنامج)
ELHAGRY_MODIFY_PASSWORD=
ELHAGRY_RESET_PASSWORD=
